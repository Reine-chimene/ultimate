# PostgreSQL
POSTGRES_USER=ultimate
POSTGRES_PASSWORD=ultimate
POSTGRES_DB=ultimate
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Backend
DATABASE_URL=postgresql+asyncpg://ultimate:ultimate@postgres:5432/ultimate
SECRET_KEY=change-me-to-a-long-random-string-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3100
BACKEND_PORT=8100

# Frontend (ports dédiés — évite conflits avec d'autres apps Docker)
NEXT_PUBLIC_API_URL=http://localhost:8100
FRONTEND_PORT=3100
