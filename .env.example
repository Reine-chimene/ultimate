# PostgreSQL
POSTGRES_USER=ultimate
POSTGRES_PASSWORD=ultimate
POSTGRES_DB=ultimate
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Backend
DATABASE_URL=postgresql+asyncpg://ultimate:ultimate@postgres:5432/ultimate
SECRET_KEY=change-me-to-a-long-random-string-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3100
BACKEND_PORT=8100

# Media uploads (local filesystem or S3-compatible)
MEDIA_STORAGE_PATH=./uploads
MEDIA_PUBLIC_URL=http://localhost:8100
STORAGE_BACKEND=local
# Optional S3 / Tigris / MinIO:
# STORAGE_BACKEND=s3
# S3_BUCKET=
# S3_ENDPOINT=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_REGION=auto
# S3_PUBLIC_BASE_URL=

# Frontend (ports dédiés — évite conflits avec d'autres apps Docker)
NEXT_PUBLIC_API_URL=http://localhost:8100
FRONTEND_PORT=3100
